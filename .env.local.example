# Copiar a .env.local y completar. .env.local NO se versiona.
# Los valores salen de supabase.com → el proyecto → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: bypasea RLS por completo. Nunca lleva el prefijo
# NEXT_PUBLIC_ (eso la mandaría al navegador) y nunca se comparte.
SUPABASE_SERVICE_ROLE_KEY=

{
  "name": "goro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "formato": "prettier --check .",
    "formato:arreglar": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:rls",
    "test:unit": "vitest run --exclude \"**/rls.test.ts\"",
    "test:rls": "vitest run --no-file-parallelism rls.test",
    "verificar": "npm run formato && npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
